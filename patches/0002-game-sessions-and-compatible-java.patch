new file mode 100644
index 0000000..c5b642c
--- /dev/null
+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/lcl/LclRuntimeChoice.java
@@ -0,0 +1,21 @@
+package net.kdt.pojavlaunch.lcl;
+
+/** Which downloadable Java runtime serves a game's Java requirement. */
+public final class LclRuntimeChoice {
+    private LclRuntimeChoice() {}
+
+    /**
+     * A game asks for a minimum Java major version that may not be published as
+     * a download itself (1.17 asks for 16; only 8, 17, 21 and 25 exist). Any
+     * newer release runs it, so the lowest published version that is not older
+     * than the requirement is the one to fetch.
+     *
+     * @return that version, or -1 when nothing published is new enough
+     */
+    public static int downloadableVersionFor(int required, int[] published) {
+        int best = -1;
+        for (int version : published)
+            if (version >= required && (best == -1 || version < best)) best = version;
+        return best;
+    }
+}
diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/lcl/LclSession.java b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/lcl/LclSession.java
new file mode 100644
index 0000000..013942d
--- /dev/null
+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/lcl/LclSession.java
@@ -0,0 +1,89 @@
+package net.kdt.pojavlaunch.lcl;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.nio.channels.FileChannel;
+import java.nio.channels.FileLock;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * The runtime's half of the host launcher's game session records, kept in
+ * "runtime-sessions" below the data root. For a session id (the host's
+ * instance id):
+ *   id.json  the state, replaced atomically. The host writes "handover"; the
+ *            entry activity writes "starting", "failed" or "cancelled"; the
+ *            game process writes "running".
+ *   id.lock  kept exclusively locked by the game process for its whole life.
+ *            The kernel releases it however the process ends, which is how the
+ *            host learns the game is over, also after it was itself restarted.
+ */
+public final class LclSession {
+    public static final String EXTRA_SESSION_ID = "lcl.session_id";
+    public static final String DIRECTORY = "runtime-sessions";
+    // Held until the process dies; never closed on purpose.
+    private static RandomAccessFile sLockFile;
+    private static FileLock sLock;
+
+    private LclSession() {}
+
+    public static boolean validId(String id) {
+        return id != null && id.matches("[A-Za-z0-9][A-Za-z0-9_.+-]{0,199}") && !id.contains("..");
+    }
+
+    static String json(String state, String message, long timeMs) {
+        StringBuilder out = new StringBuilder("{\"state\":\"").append(escape(state)).append("\",\"time\":").append(timeMs);
+        if (message != null) out.append(",\"message\":\"").append(escape(message)).append('"');
+        return out.append('}').toString();
+    }
+
+    private static String escape(String text) {
+        StringBuilder out = new StringBuilder();
+        for (int i = 0; i < text.length(); i++) {
+            char c = text.charAt(i);
+            if (c == '"' || c == '\\') out.append('\\').append(c);
+            else if (c < 0x20) out.append(String.format("\\u%04x", (int) c));
+            else out.append(c);
+        }
+        return out.toString();
+    }
+
+    /** Replaces the state record. Invalid ids and missing directories are ignored. */
+    public static void write(File dataRoot, String id, String state, String message) throws IOException {
+        if (!validId(id)) return;
+        File directory = new File(dataRoot, DIRECTORY);
+        if (!directory.isDirectory()) return; // only the host creates sessions
+        File target = new File(directory, id + ".json");
+        File partial = new File(directory, id + ".json.part");
+        try (FileOutputStream output = new FileOutputStream(partial)) {
+            output.write(json(state, message, System.currentTimeMillis()).getBytes(StandardCharsets.UTF_8));
+            output.getFD().sync();
+        }
+        if (!partial.renameTo(target)) {
+            partial.delete();
+            throw new IOException("Could not publish the session state " + state);
+        }
+    }
+
+    /**
+     * Takes the game lock for the rest of this process's life.
+     * @return whether this process now holds (or already held) the lock
+     */
+    public static synchronized boolean holdForProcessLifetime(File dataRoot, String id) throws IOException {
+        if (sLock != null) return true;
+        if (!validId(id)) return false;
+        File lock = new File(new File(dataRoot, DIRECTORY), id + ".lock");
+        if (!lock.isFile()) return false;
+        RandomAccessFile file = new RandomAccessFile(lock, "rw");
+        FileChannel channel = file.getChannel();
+        FileLock held = channel.tryLock();
+        if (held == null) {
+            file.close();
+            return false;
+        }
+        sLockFile = file;
+        sLock = held;
+        return true;
+    }
+}
diff --git a/app_pojavlauncher/src/test/java/net/kdt/pojavlaunch/lcl/LclRuntimeChoiceTest.java b/app_pojavlauncher/src/test/java/net/kdt/pojavlaunch/lcl/LclRuntimeChoiceTest.java
