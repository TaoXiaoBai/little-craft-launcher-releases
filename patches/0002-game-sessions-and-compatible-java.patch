+++ b/app_pojavlauncher/src/test/java/net/kdt/pojavlaunch/lcl/LclSessionTest.java
@@ -0,0 +1,67 @@
+package net.kdt.pojavlaunch.lcl;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+
+public class LclSessionTest {
+    @Rule
+    public TemporaryFolder folder = new TemporaryFolder();
+
+    @Test
+    public void idsAreSingleSafeFileNames() {
+        assertTrue(LclSession.validId("survival-1"));
+        assertTrue(LclSession.validId("a.b_c+d"));
+        assertFalse(LclSession.validId(null));
+        assertFalse(LclSession.validId(""));
+        assertFalse(LclSession.validId("../escape"));
+        assertFalse(LclSession.validId("a/b"));
+        assertFalse(LclSession.validId("a..b"));
+        assertFalse(LclSession.validId(".hidden"));
+    }
+
+    @Test
+    public void recordsAreCompactEscapedJson() {
+        assertEquals("{\"state\":\"running\",\"time\":5}", LclSession.json("running", null, 5));
+        assertEquals("{\"state\":\"failed\",\"time\":7,\"message\":\"a \\\"b\\\" \\\\ \\u000ac\"}",
+                LclSession.json("failed", "a \"b\" \\ \nc", 7));
+    }
+
+    @Test
+    public void writesOnlyIntoSessionsTheHostCreated() throws Exception {
+        File root = folder.newFolder("root");
+        // No session directory: the host never asked, nothing is created.
+        LclSession.write(root, "survival-1", "running", null);
+        assertFalse(new File(root, LclSession.DIRECTORY).exists());
+        File directory = new File(root, LclSession.DIRECTORY);
+        assertTrue(directory.mkdirs());
+        LclSession.write(root, "../escape", "running", null);
+        assertEquals(0, directory.list().length);
+        LclSession.write(root, "survival-1", "failed", "no runtime");
+        String text = new String(Files.readAllBytes(new File(directory, "survival-1.json").toPath()), StandardCharsets.UTF_8);
+        assertTrue(text.startsWith("{\"state\":\"failed\",\"time\":"));
+        assertTrue(text.endsWith(",\"message\":\"no runtime\"}"));
+        assertFalse(new File(directory, "survival-1.json.part").exists());
+    }
+
+    @Test
+    public void lockNeedsTheHostsLockFile() throws Exception {
+        File root = folder.newFolder("root");
+        File directory = new File(root, LclSession.DIRECTORY);
+        assertTrue(directory.mkdirs());
+        assertFalse(LclSession.holdForProcessLifetime(root, "survival-1"));
+        assertFalse(LclSession.holdForProcessLifetime(root, "../escape"));
+        assertTrue(new File(directory, "survival-1.lock").createNewFile());
+        assertTrue(LclSession.holdForProcessLifetime(root, "survival-1"));
+        // Idempotent for the life of the process.
+        assertTrue(LclSession.holdForProcessLifetime(root, "survival-1"));
+    }
+}
