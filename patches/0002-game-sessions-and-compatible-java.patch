@@ -0,0 +1,37 @@
+package net.kdt.pojavlaunch.lcl;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+
+public class LclRuntimeChoiceTest {
+    private static final int[] PUBLISHED = {8, 17, 21, 25};
+
+    @Test
+    public void java16GamesGetJava17() {
+        // Minecraft 1.17 and 1.17.1 require Java 16, which is not published.
+        // With only the bundled Java 8 installed this is the download to make.
+        assertEquals(17, LclRuntimeChoice.downloadableVersionFor(16, PUBLISHED));
+    }
+
+    @Test
+    public void exactVersionsAreKept() {
+        assertEquals(8, LclRuntimeChoice.downloadableVersionFor(8, PUBLISHED));
+        assertEquals(17, LclRuntimeChoice.downloadableVersionFor(17, PUBLISHED));
+        assertEquals(21, LclRuntimeChoice.downloadableVersionFor(21, PUBLISHED));
+        assertEquals(25, LclRuntimeChoice.downloadableVersionFor(25, PUBLISHED));
+    }
+
+    @Test
+    public void gapsRoundUpAndTheOrderDoesNotMatter() {
+        assertEquals(17, LclRuntimeChoice.downloadableVersionFor(9, new int[]{25, 21, 17, 8}));
+        assertEquals(25, LclRuntimeChoice.downloadableVersionFor(22, PUBLISHED));
+        assertEquals(8, LclRuntimeChoice.downloadableVersionFor(0, PUBLISHED));
+    }
+
+    @Test
+    public void nothingNewEnough() {
+        assertEquals(-1, LclRuntimeChoice.downloadableVersionFor(26, PUBLISHED));
+        assertEquals(-1, LclRuntimeChoice.downloadableVersionFor(8, new int[]{}));
+    }
+}
diff --git a/app_pojavlauncher/src/test/java/net/kdt/pojavlaunch/lcl/LclSessionTest.java b/app_pojavlauncher/src/test/java/net/kdt/pojavlaunch/lcl/LclSessionTest.java
