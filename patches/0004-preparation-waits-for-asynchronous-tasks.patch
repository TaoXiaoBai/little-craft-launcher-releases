      */
-    public static Outcome run(String sessionId, Work work, Cancellation cancellation, Reporter reporter) {
+    public static Outcome run(String sessionId, Work work, Cancellation cancellation, Settle settle, Reporter reporter) {
         if (!sExclusive.tryLock()) {
             String active = sActiveSession;
             if (sessionId == null || !sessionId.equals(active))
@@ -93,14 +102,31 @@ public final class LclPreparation {
                 message = reason == null || reason.isEmpty() ? throwable.getClass().getSimpleName() : firstLine(reason);
             }
         } finally {
+            // Whatever the outcome, the shared files stay ours until every
+            // asynchronous task the work started has ended as well.
+            awaitQuiet(settle);
             sActiveSession = null;
             sExclusive.unlock();
         }
-        // Reported only now: the work has stopped and released the shared files.
+        // Reported only now: the work and everything it started have stopped
+        // and released the shared files.
         if (state != null) reporter.report(state, message);
         return outcome;
     }
 
+    private static void awaitQuiet(Settle settle) {
+        boolean interrupted = false;
+        while (true) {
+            try {
+                settle.awaitQuiet();
+                break;
+            } catch (InterruptedException e) {
+                interrupted = true; // keep waiting: releasing early is the bug
+            }
+        }
+        if (interrupted) Thread.currentThread().interrupt();
+    }
