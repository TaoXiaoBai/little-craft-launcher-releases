+    private static final LclPreparation.Settle NOTHING_ELSE = () -> { };
+
+    /**
+     * The work has returned, but a task it queued on an executor (as component
+     * unpacking does) is still writing -> leave the screen -> retry at once.
+     * Run for both ways the outer work can end early.
+     */
+    private void asynchronousChildHoldsThePreparation(final boolean outerFails) throws Exception {
+        final ExecutorService executor = Executors.newFixedThreadPool(4);
+        try {
+            final CountDownLatch childStarted = new CountDownLatch(1);
+            final CountDownLatch releaseChild = new CountDownLatch(1);
+            final AtomicInteger writing = new AtomicInteger();
+            final AtomicInteger mostWritingAtOnce = new AtomicInteger();
+            final List<Future<?>> children = Collections.synchronizedList(new ArrayList<>());
+            // Waits for exactly the tasks this preparation queued.
+            final LclPreparation.Settle settle = () -> {
+                for (Future<?> child : new ArrayList<>(children)) {
+                    try {
+                        child.get();
+                    } catch (ExecutionException e) {
+                        throw new AssertionError(e);
+                    }
+                }
+            };
+            final LclPreparation.Work work = cancellation -> {
+                children.add(executor.submit(() -> {
+                    mostWritingAtOnce.accumulateAndGet(writing.incrementAndGet(), Math::max);
+                    try {
+                        childStarted.countDown();
+                        releaseChild.await(30, TimeUnit.SECONDS); // a slow shared-directory write
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    } finally {
+                        writing.decrementAndGet();
+                    }
+                }));
+                assertTrue(childStarted.await(30, TimeUnit.SECONDS));
+                if (outerFails) throw new IllegalStateException("No compatible Java runtime");
+                cancellation.request();   // the user left the screen
+                cancellation.check();     // ... and the outer work exits here
+            };
+            final Reports first = new Reports();
+            final AtomicReference<LclPreparation.Outcome> firstOutcome = new AtomicReference<>();
+            Thread preparing = new Thread(() -> firstOutcome.set(LclPreparation.run("survival-1", work,
+                    new LclPreparation.Cancellation(), settle, first)));
+            preparing.start();
+            assertTrue(childStarted.await(30, TimeUnit.SECONDS));
+            // Give the outer work time to leave its own call stack.
+            preparing.join(300);
+            assertTrue("the preparation is not over while its child still writes", preparing.isAlive());
+            assertTrue("no final state before the child stopped", first.snapshot().isEmpty());
+            assertEquals(1, writing.get());
+
+            // An immediate retry must not start a second writer.
+            final Reports retry = new Reports();
+            final AtomicInteger retryRan = new AtomicInteger();
+            assertEquals(LclPreparation.Outcome.BUSY, LclPreparation.run("survival-1",
+                    cancellation -> retryRan.incrementAndGet(), new LclPreparation.Cancellation(), NOTHING_ELSE, retry));
+            assertEquals(0, retryRan.get());
+            assertTrue(retry.snapshot().isEmpty());
+            assertTrue(first.snapshot().isEmpty());
+
+            // The child finishes: only now does the final state go out.
+            releaseChild.countDown();
+            preparing.join(30000);
+            assertFalse(preparing.isAlive());
+            assertEquals(outerFails ? LclPreparation.Outcome.FAILED : LclPreparation.Outcome.CANCELLED, firstOutcome.get());
+            assertEquals(1, first.snapshot().size());
+            assertEquals(outerFails ? "failed:No compatible Java runtime" : "cancelled", first.snapshot().get(0));
+            assertEquals(0, writing.get());
+            assertEquals(1, mostWritingAtOnce.get());
+
+            // And a retry prepares normally again.
+            final Reports again = new Reports();
+            assertEquals(LclPreparation.Outcome.PREPARED, LclPreparation.run("survival-1",
+                    cancellation -> retryRan.incrementAndGet(), new LclPreparation.Cancellation(), NOTHING_ELSE, again));
+            assertEquals(1, retryRan.get());
+        } finally {
+            executor.shutdownNow();
+        }
+    }
+
+    @Test
+    public void cancellationWaitsForAsynchronousChildren() throws Exception {
+        asynchronousChildHoldsThePreparation(false);
+    }
+
+    @Test
+    public void failureWaitsForAsynchronousChildren() throws Exception {
+        asynchronousChildHoldsThePreparation(true);
+    }
+
+    @Test
+    public void successWaitsForAsynchronousChildrenToo() throws Exception {
+        final CountDownLatch release = new CountDownLatch(1);
+        final AtomicReference<LclPreparation.Outcome> outcome = new AtomicReference<>();
+        Thread preparing = new Thread(() -> outcome.set(LclPreparation.run("a", cancellation -> { },
+                new LclPreparation.Cancellation(), () -> release.await(), new Reports())));
+        preparing.start();
+        preparing.join(300);
+        assertTrue(preparing.isAlive());
+        assertEquals(LclPreparation.Outcome.BUSY, LclPreparation.run("a", cancellation -> { },
+                new LclPreparation.Cancellation(), NOTHING_ELSE, new Reports()));
+        release.countDown();
+        preparing.join(30000);
+        assertEquals(LclPreparation.Outcome.PREPARED, outcome.get());
+    }
+
