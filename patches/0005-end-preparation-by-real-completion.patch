+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/lcl/LclProgress.java
@@ -0,0 +1,30 @@
+package net.kdt.pojavlaunch.lcl;
+
+import net.kdt.pojavlaunch.progresskeeper.ProgressKeeper;
+
+import java.util.concurrent.Callable;
+
+/**
+ * Progress records of the runtime's synchronous steps.
+ *
+ * The runtime shows the Java download and unpacking through a progress record
+ * that is only cleared when unpacking succeeds. A download that fails after it
+ * received data (a read timeout, a dropped connection) therefore leaves the
+ * record behind although nothing is running any more. Left alone it would keep
+ * every "wait until the runtime is idle" waiting for ever.
+ */
+public final class LclProgress {
+    private LclProgress() {}
+
+    /**
+     * Runs a step that is finished when it returns or throws, and guarantees
+     * that none of the given progress records outlives it.
+     */
+    public static <T> T clearing(String[] progressRecords, Callable<T> step) throws Exception {
+        try {
+            return step.call();
+        } finally {
+            for (String record : progressRecords) ProgressKeeper.submitProgress(record, -1, -1);
+        }
+    }
+}
