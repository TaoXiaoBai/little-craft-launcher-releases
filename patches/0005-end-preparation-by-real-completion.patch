diff --git a/app_pojavlauncher/src/test/java/net/kdt/pojavlaunch/lcl/LclJavaDownloadFailureTest.java b/app_pojavlauncher/src/test/java/net/kdt/pojavlaunch/lcl/LclJavaDownloadFailureTest.java
new file mode 100644
index 0000000..9830bec
--- /dev/null
+++ b/app_pojavlauncher/src/test/java/net/kdt/pojavlaunch/lcl/LclJavaDownloadFailureTest.java
@@ -0,0 +1,180 @@
+package net.kdt.pojavlaunch.lcl;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import net.kdt.pojavlaunch.progresskeeper.DownloaderProgressWrapper;
+import net.kdt.pojavlaunch.progresskeeper.ProgressKeeper;
+import net.kdt.pojavlaunch.utils.DownloadUtils;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.InetAddress;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * The Java download as the preparation really runs it: the runtime's own
+ * downloader, progress wrapper and progress keeper. A server sends part of the
+ * archive and then stalls, so the downloader's own read timeout fires after a
+ * progress record was registered. The downloader does not clear that record.
+ */
+public class LclJavaDownloadFailureTest {
+    private static final String RECORD = "unpack_runtime"; // ProgressLayout.UNPACK_RUNTIME
+
+    @Rule
+    public TemporaryFolder folder = new TemporaryFolder();
+    private ServerSocket mServer;
+    private final List<Socket> mClients = new ArrayList<>();
+    private final CountDownLatch mPartSent = new CountDownLatch(1);
+
+    private static final class Reports implements LclPreparation.Reporter {
+        final List<String> entries = new ArrayList<>();
+
+        @Override
+        public synchronized void report(String state, String message) {
+            entries.add(message == null ? state : state + ":" + message);
+        }
+
+        synchronized List<String> snapshot() {
+            return new ArrayList<>(entries);
+        }
+    }
+
+    @Before
+    public void startStallingServer() throws Exception {
+        ProgressKeeper.submitProgress(RECORD, -1, -1);
+        mServer = new ServerSocket(0, 4, InetAddress.getLoopbackAddress());
+        Thread acceptor = new Thread(() -> {
+            try {
+                while (true) {
+                    Socket client = mServer.accept();
+                    synchronized (mClients) {
+                        mClients.add(client);
+                    }
+                    InputStream request = client.getInputStream();
+                    // Read the request head.
+                    int matched = 0;
+                    while (matched < 4) {
+                        int value = request.read();
+                        if (value < 0) break;
+                        matched = (value == (matched % 2 == 0 ? 13 : 10)) ? matched + 1 : 0;
+                    }
+                    OutputStream response = client.getOutputStream();
+                    response.write("HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: 8000000\r\n\r\n"
+                            .getBytes(StandardCharsets.US_ASCII));
+                    response.write(new byte[200000]);
+                    response.flush();
+                    mPartSent.countDown();
+                    // ... and never send the rest.
+                }
+            } catch (Exception closed) {
+                // The test is over.
+            }
+        });
+        acceptor.setDaemon(true);
+        acceptor.start();
+    }
+
+    @After
+    public void stopServer() throws Exception {
+        mServer.close();
+        synchronized (mClients) {
+            for (Socket client : mClients) client.close();
+        }
+        ProgressKeeper.submitProgress(RECORD, -1, -1);
+    }
+
+    private LclPreparation.Work javaDownload(final File archive, final AtomicInteger ended) {
+        final String url = "http://127.0.0.1:" + mServer.getLocalPort() + "/jre17-android-aarch64.tar.xz";
+        return (cancellation, tasks) -> {
+            try {
+                // Exactly the wiring of LclGameEntryActivity around the Java step.
+                LclProgress.clearing(new String[]{RECORD}, () -> {
+                    DownloadUtils.downloadFileMonitored(url, archive, null, new DownloaderProgressWrapper(0, RECORD));
+                    return true;
+                });
+            } finally {
+                ended.incrementAndGet();
+            }
+        };
+    }
+
+    private void interruptedDownloadEndsThePreparation(final boolean userLeft) throws Exception {
+        final File archive = new File(folder.newFolder(), "jre17.tar.xz");
+        final AtomicInteger ended = new AtomicInteger();
+        final Reports reports = new Reports();
+        final LclPreparation.Cancellation cancellation = new LclPreparation.Cancellation();
+        final AtomicReference<LclPreparation.Outcome> outcome = new AtomicReference<>();
+        Thread preparing = new Thread(() ->
+                outcome.set(LclPreparation.run("survival-1", javaDownload(archive, ended), cancellation, reports)));
+        preparing.start();
+
+        // The real downloader received data and registered real progress.
+        assertTrue(mPartSent.await(30, TimeUnit.SECONDS));
+        long deadline = System.currentTimeMillis() + 10000;
+        while (ProgressKeeper.getTaskCount() == 0 && System.currentTimeMillis() < deadline) Thread.sleep(20);
+        assertEquals("the downloader registered its progress record", 1, ProgressKeeper.getTaskCount());
+        assertTrue(preparing.isAlive());
+        if (userLeft) cancellation.request();
+        // While the download is still in flight nothing is reported and a retry is refused.
+        assertTrue(reports.snapshot().isEmpty());
+        final AtomicInteger retryRan = new AtomicInteger();
+        assertEquals(LclPreparation.Outcome.BUSY, LclPreparation.run("survival-1",
+                (ignored, tasks) -> retryRan.incrementAndGet(), new LclPreparation.Cancellation(), new Reports()));
+        assertEquals(0, retryRan.get());
+
+        // The downloader's own read timeout (10 s) ends the download thread.
+        preparing.join(40000);
+        assertFalse("the preparation must end once the download work has ended", preparing.isAlive());
+        assertEquals(1, ended.get());
+        assertEquals(userLeft ? LclPreparation.Outcome.CANCELLED : LclPreparation.Outcome.FAILED, outcome.get());
+        assertEquals(1, reports.snapshot().size());
+        if (userLeft) assertEquals("cancelled", reports.snapshot().get(0));
+        else assertTrue(reports.snapshot().get(0), reports.snapshot().get(0).startsWith("failed:Unable to download from "));
+        assertEquals("no progress record is left behind", 0, ProgressKeeper.getTaskCount());
+
+        // A retry is accepted again and prepares normally.
+        assertEquals(LclPreparation.Outcome.PREPARED, LclPreparation.run("survival-1",
+                (ignored, tasks) -> retryRan.incrementAndGet(), new LclPreparation.Cancellation(), new Reports()));
+        assertEquals(1, retryRan.get());
+    }
+
+    @Test
+    public void readTimeoutAfterProgressReportsFailedAndRecovers() throws Exception {
+        interruptedDownloadEndsThePreparation(false);
+    }
+
+    @Test
+    public void readTimeoutAfterLeavingReportsCancelledAndRecovers() throws Exception {
+        interruptedDownloadEndsThePreparation(true);
+    }
+
+    /** What the reviewer observed: without the clean-up the record stays. */
+    @Test
+    public void theDownloaderAloneLeavesItsRecordBehind() throws Exception {
+        final File archive = new File(folder.newFolder(), "jre17.tar.xz");
+        final String url = "http://127.0.0.1:" + mServer.getLocalPort() + "/jre17-android-aarch64.tar.xz";
+        try {
+            DownloadUtils.downloadFileMonitored(url, archive, null, new DownloaderProgressWrapper(0, RECORD));
+            throw new AssertionError("the stalled download must time out");
+        } catch (java.io.IOException expected) {
+            assertEquals(1, ProgressKeeper.getTaskCount());
+        }
+    }
+}
